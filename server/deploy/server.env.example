# Initial Pi deployment explicitly uses the SD card (no external drive mounted).
# Copy to ~/.config/sombrero/server.env and chmod 600.
SOMBRERO_DATA_DIR=/home/admin/.local/share/sombrero
SOMBRERO_MEDIA_DIR=/home/admin/.local/share/sombrero/media
SOMBRERO_MAX_IMAGE_BYTES=10485760
SOMBRERO_MAX_VIDEO_BYTES=104857600
