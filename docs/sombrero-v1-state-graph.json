  "knownNotes": [
    "1a black weights sum to 1.02; preserved literally and normalized as relative weights, not silently edited.",
    "Single black arrows without a written weight are treated as deterministic weight 1.",
    "Check red guards on entry before issuing play; skipped gateway clips render no frame.",
    "No implicit event-interrupt edges are added to other states.",
    "Only server acknowledgment of the active composer message clears takingPhoto; capture and offline enqueue hold 6b. The purple exit waits for the current 6b clip.",
    "Pet release/event exits are immediate after the first full pet cycle; self-loops retain completion eligibility. Dialogue forces pet false, including while the bubble is growing/collapsing.",
    "Recall weights (4c top, 4b screen, 4b window side): neither clearance 0/1/0; top only .8/.2/0; side only 0/.5/.5; both .4/.4/.2. Window-side 4b detaches at clip end; 4c stays attached until drag or the target disappears."
  ],
  "petPolicy": {
    "minimumCyclesPerSession": 1,
    "dialogueForcesPetFalse": true,
    "releaseAfterFirstCycle": "interrupt-immediately",
    "petCycleCompleted": "derived from a valid completion of 1d or 3c; preserved across self-loops and reset on state changes"
  },
  "photoArtworkUpdate": "November 21, 2026: supplied three-clip artwork supersedes the original PDF four-step photo numbering: 5a pull out, 5b held loop, 5c put away. Preserve the purple held-loop exit timing."
